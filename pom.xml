<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.starfallplain.CN_Ran</groupId>
    <artifactId>sfp-main</artifactId>
    <version>2.6.0</version>
    <packaging>jar</packaging>

    <name>sfp-main</name>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Paper API 目标版本：Minecraft Java 26.3（代号 Wilderness Bound）。
          26.3 目前官方只发布到 beta 构建，没有 stable，故显式锁定具体构建号，
          这样离线（-o）构建也能稳定复现；升到 26.4 时改这一处即可。
          服务器最低要求由 paper-plugin.yml 的 api-version 决定（当前 26.1）。
        -->
        <paper.version>26.3.build.142-beta</paper.version>

        <!--
          ===== 以下四个版本号纯粹用于「覆盖 paper-api 传递进来的依赖版本」=====
          它们全部是 provided 作用域：只参与编译，不会被打进插件 jar
          （可用 unzip -l 检查 target 里的 jar，里面只有 cn/ 与 shade 的 org/sqlite）。
          本插件代码也从不调用这几个库的 API，因此覆盖版本对运行行为零影响，
          目的仅是让依赖树里不再出现已知漏洞版本。
        -->

        <!-- CVE-2026-49844：MapMessage.asJson() 对非有限浮点值序列化不合规。
             受影响 [2.13.1, 2.25.5) ∪ [2.26.0, 2.26.1)，修复版本 2.25.5 / 2.26.1 -->
        <log4j-api.version>2.26.1</log4j-api.version>

        <!-- CVE-2025-67030：Expand#extractFile 目录穿越（CVSS 8.8）。
             GHSA-6fmv-xxpf-w3cw 列出的 patched 版本：3.6.1（3.x 线）/ 4.0.3（4.x 线）。
             保持 3.x 线（maven-* 3.9.6 依赖同级），故取 3.6.1 -->
        <plexus-utils.version>3.6.1</plexus-utils.version>

        <!-- CVE-2025-48924：ClassUtils#getShortClassName 递归失控导致 StackOverflowError。
             受影响 3.0 ~ 3.18.0 之前，修复版本 3.18.0 -->
        <commons-lang3.version>3.18.0</commons-lang3.version>

        <!-- CVE-2022-25647 / WS-2021-0419：gson 2.8.9 之前反序列化漏洞。
             说明：Maven 实际仲裁结果本来就已是 2.14.0（paper-api 直连的 gson 层级更浅，
             bungeecord-chat 声明的 2.8.8 被淘汰），这里显式写出来是为了让解析结果一目了然、
             并消除 IDE 依赖树上「按声明版本标注」产生的误报 -->
        <gson.version>2.14.0</gson.version>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <!-- 项目编译目标为 Java 25，需 ASM 9.8+ 才能处理 class 文件版本 69 -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.8</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.8</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                              不重定位 org.sqlite：SQLite JDBC 原生加载器内部使用
                              字符串形式的类名（org.sqlite.core.NativeDB），shade 无法重写，
                              重定位会导致 NoClassDefFoundError。Paper 每个插件有独立类加载器，
                              不重定位也不会有类冲突问题。
                            -->
                            <transformers>
                                <!-- 保留并合并 META-INF/services，保证 DriverManager 能发现驱动 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!--
                                  显式生成 MANIFEST.MF。
                                  不加这个 transformer 时，项目 jar 与 sqlite-jdbc jar 各自带一份
                                  META-INF/MANIFEST.MF，shade 会打印
                                  "1 overlapping resource: META-INF/MANIFEST.MF" 警告
                                  （实际取的是项目自己那份，不影响产物，但刷日志）。
                                  交给 transformer 处理后该资源不再参与合并，警告消失，清单内容也可控。
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Implementation-Title>${project.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!--
                                          每个 jar 都自带一份 MANIFEST.MF，两份相撞会让 shade 打印
                                          "1 overlapping resource: META-INF/MANIFEST.MF" 警告。
                                          这里全部排除，最终清单统一由上面的 ManifestResourceTransformer 生成。
                                        -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <!--
      统一收敛传递依赖的版本。dependencyManagement 只覆盖版本号，
      不改变作用域 —— log4j-api 仍由 paper-api 以 provided 引入，不会进插件 jar。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j-api.version}</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.plexus</groupId>
                <artifactId>plexus-utils</artifactId>
                <version>${plexus-utils.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- SQLite JDBC：传送数据（home / warp / back）持久化，打包进插件 jar -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
